{%- extends "template.html.j2" -%}

{%- import "elements/buttons.html.j2" as buttons -%}
{%- import "elements/textinput.html.j2" as text_input -%}
{%- import "elements/listing.html.j2" as listing -%}

{%- block head -%}
    {{super()}}
    <link rel="stylesheet" href="{{ url_for('static', filename='stylesheets/settings.css') }}">
{%- endblock -%}

{%- block content -%}
    <div class="container">
        <h1>Settings</h1>
        <p>Manage your API key, groups, and other settings here.</p>
    </div>

    <div class="container">
        <h2>API Settings</h2>

        <div class="settings">
            {{- text_input.text_input("User ID", "user-id", "Enter your user ID here", default_value=config['USER'].get_user_id() or "") -}}
            {{- text_input.password_input("API Key", "api-key", "Enter your API key here", default_value=config['USER'].current_api_key or "") -}}
            {{- buttons.contained_button("Save Login", onclick="saveLoginInfo()", classes="group-button" ) -}}
        </div>
    </div>

    <div class="container">
        <h2>Group Settings</h2>
        <div class="settings">
            {{- listing.group_list(config['USER'].get_groups() or []) -}}
            <div class="line-seperator"></div>
            <div class="current-target">
                <p>Target Group</p>
                <p>{{ config['USER'].get_target_group_name() or "None" }}</p>
            </div>
            {{- text_input.text_input("New Group Name", "new-group-name", "Enter new group name") -}}
            {{- text_input.text_input("New Group ID", "new-group-id", "Enter new group ID") -}}
            {{- buttons.contained_button("Add Group", id="add-group-button", onclick="addGroup()", classes="group-button" ) -}}
        </div>
    </div>

    <div class="container">
        <h2>Application Settings</h2>
        <div class="settings">
            {% if config['WEBVIEW_WINDOW'] %}
                {%- if config['WEBVIEW_WINDOW'].on_top -%}
                    {{- buttons.contained_button("Disable Always On Top", onclick="toggleAlwaysOnTop()") -}}
                {%- else -%}
                    {{- buttons.outlined_button("Enable Always On Top", onclick="toggleAlwaysOnTop()") -}}
                {%- endif -%}
            {% endif %}

            {{- buttons.contained_button("Open AppData", onclick="openAppData()") -}}
        </div>
    </div>

    <script>
        function saveLoginInfo() {
            const userId = document.getElementById('user-id').value;
            const apiKey = document.getElementById('api-key').value;

            console.log(`Saving login info with user ID: ${userId}`);

            fetch('/settings/save-login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ user_id: userId, api_key: apiKey })
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to save login information. Please check your API key and try again.');
                }
            })
            .catch(error => {
                console.error('Error saving login information:', error);
                alert('An error occurred while saving login information. Please try again later.');
            });
        }
        function addGroup() {
            const groupName = document.getElementById('new-group-name').value;
            const groupId = document.getElementById('new-group-id').value;
            if (!groupName || !groupId) {
                alert('Please enter both a group name and ID.');
                return;
            }

            console.log(`Adding group with name: ${groupName} and ID: ${groupId}`);

            fetch('/settings/add-group', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ group_name: groupName, group_id: groupId })
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to add group.');
                }
            })
            .catch(error => {
                console.error('Error adding group:', error);
                alert('An error occurred while adding the group.');
            });
        }

        function setTargetGroup(groupId) {
            console.log(`Setting target group: ${groupId}`);

            fetch('/settings/set-target-group', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ target_group: groupId })
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to set target group.');
                }
            })
            .catch(error => {
                console.error('Error setting target group:', error);
                alert('An error occurred while setting the target group.');
            });
        }

        function removeGroup(groupId) {
            console.log(`Removing group: ${groupId}`);

            fetch('/settings/remove-group', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ group_id: groupId })
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to remove group.');
                }
            })
            .catch(error => {
                console.error('Error removing group:', error);
                alert('An error occurred while removing the group.');
            });
        }

        function openAppData() {
            fetch('/settings/open-appdata', {
                method: 'POST'
            })
            .then(response => {
                if (!response.ok) {
                    alert('Failed to open AppData folder.');
                }
            })
            .catch(error => {
                console.error('Error opening AppData folder:', error);
                alert('An error occurred while trying to open the AppData folder.');
            });
        }

        function toggleAlwaysOnTop() {
            fetch('/settings/toggle-always-on-top', {
                method: 'POST'
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to toggle Always On Top setting.');
                }
            })
            .catch(error => {
                console.error('Error toggling Always On Top setting:', error);
                alert('An error occurred while toggling the Always On Top setting.');
            });
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function (event) {
            var scrollpos = sessionStorage.getItem('scrollpos');
            if (scrollpos) {
                window.scrollTo(0, scrollpos);
                sessionStorage.removeItem('scrollpos');
            }
        });

        window.addEventListener("beforeunload", function (e) {
            sessionStorage.setItem('scrollpos', window.scrollY);
        });
    </script>
{%- endblock -%}